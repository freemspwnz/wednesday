        { "expr": "histogram_quantile(0.95, sum by (le, name) (rate(wednesday_cb_call_duration_seconds_bucket[5m])))", "legendFormat": "cb p95 {{name}}", "refId": "B" }
      ],
      "title": "Resilience latency p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vm_ds" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "green", "index": 0, "text": "CLOSED" } }, "type": "value" },
            { "options": { "0.5": { "color": "yellow", "index": 1, "text": "HALF_OPEN" } }, "type": "value" },
            { "options": { "1": { "color": "red", "index": 2, "text": "OPEN" } }, "type": "value" }
          ]
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 4,
