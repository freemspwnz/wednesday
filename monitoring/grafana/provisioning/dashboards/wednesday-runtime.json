      "targets": [
        { "expr": "sum by (name, status) (rate(wednesday_retry_attempts_total[5m]))", "legendFormat": "{{name}} | {{status}}", "refId": "A" },
        { "expr": "sum by (name, result) (rate(wednesday_cb_calls_total[5m]))", "legendFormat": "cb {{name}} | {{result}}", "refId": "B" }
