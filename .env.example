# Copy to .env and fill in. Nested keys use "__" (pydantic-settings).
# Do not commit .env. Restart the bot after changes.

# ===== Environment =====
ENV=DEV

# ===== Logging =====
LOGGING__FILE_PATH=/var/tmp/logs/wednesday.log
LOGGING__LEVEL=INFO
LOGGING__TO_FILE=False

# ===== Metrics =====
METRICS__ENABLED=False
# 0.0.0.0 — scrape from Docker/VM network; localhost — host-only
METRICS__HOST=0.0.0.0
METRICS__PORT=8080

# ===== Telegram =====
TELEGRAM__ADMIN_ID=your_telegram_user_id_here
TELEGRAM__TOKEN=your_telegram_token_here

# ===== Postgres =====
POSTGRES__DB_NAME=your_postgres_db_name_here
POSTGRES__HOST=localhost
POSTGRES__PASSWORD=your_postgres_password_here
POSTGRES__PORT=5432
POSTGRES__USER=your_postgres_user_here

# ===== Redis =====
REDIS__HOST=localhost
REDIS__PASSWORD=your_redis_password_here
REDIS__PORT=6379

# ===== YAML Catalog =====
YAML__MODELS_PATH=/app/catalog/models.yaml
YAML__PROMPTS_PATH=/app/catalog/prompts.yaml
YAML__SUBSCRIPTIONS_PATH=/app/catalog/subscriptions.yaml

# ===== GigaChat =====
# Defaults: infra.config.integrations.GigaChatConfig — override only what you need.
# Auth key: Base64(client_id:client_secret) from https://developers.sber.ru/
GIGACHAT__AUTH_KEY=your_auth_key_here

# bool or path to a CA bundle. GigaChat often needs Russian Trusted Root CA
# (not in default Mozilla store). Keep *.pem gitignored; see gosuslugi.ru/crt.
GIGACHAT__CERT=certs/russiantrustedca.pem
