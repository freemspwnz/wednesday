# ===== Environment =====
ENV=DEV

# ===== Logging =====
LOGGING__FILE_PATH=/var/tmp/logs/wednesday.log
LOGGING__LEVEL=INFO
LOGGING__TO_FILE=False

# ===== Metrics =====
METRICS__ENABLED=False
# 0.0.0.0 — Docker / VM scrape over the monitoring network; localhost — host-only dev
METRICS__HOST=0.0.0.0
METRICS__PORT=8080

# ===== Telegram =====
TELEGRAM__ADMIN_ID=your_telegram_user_id_here
TELEGRAM__TOKEN=your_telegram_token_here

# ===== Postgres =====
POSTGRES__DB_NAME=your_postgres_db_name_here
POSTGRES__HOST=localhost
POSTGRES__PASSWORD=your_postgres_password_here
POSTGRES__PORT=5432
POSTGRES__USER=your_postgres_user_here

# ===== Redis =====
REDIS__HOST=localhost
REDIS__PASSWORD=your_redis_password_here
REDIS__PORT=6379

# ===== YAML Catalog =====
YAML__MODELS_PATH=/app/catalog/models.yaml
YAML__PROMPTS_PATH=/app/catalog/prompts.yaml
YAML__SUBSCRIPTIONS_PATH=/app/catalog/subscriptions.yaml

# ===== Scheduler =====
# SCHEDULER__SEND_TIMES=09:00,12:00,18:00
# SCHEDULER__TZ=Europe/Moscow
# SCHEDULER__WEDNESDAY_DAY=2

# ===== Gigachat =====
# Nested keys use ENV_NESTED_DELIMITER="__" (see Config / pydantic-settings).
# Defaults live in infra.config.integrations.GigaChatConfig — override only what you need.

# Authorization key for GigaChat API (Base64 client_id:client_secret)
# Get it at https://developers.sber.ru/
GIGACHAT__AUTH_KEY=your_auth_key_here

# Optional overrides (built-in defaults usually suffice)
# GIGACHAT__AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# GIGACHAT__SCOPE=GIGACHAT_API_PERS

# HTTP client (HttpConfig under gigachat.http)
# GIGACHAT__HTTP__BASE_URL=https://gigachat.devices.sberbank.ru/api/v1/
# GIGACHAT__HTTP__HTTP2=True
# GIGACHAT__HTTP__FOLLOW_REDIRECTS=True

# SSL verification: bool (True/False) or path to a CA bundle (.pem).
# GigaChat is often signed by Russian Trusted Root CA (Минцифры), which is NOT
# in the default Mozilla/trust store on many machines. For those hosts, point
# verify at a local CA file (do not commit *.pem — it is gitignored):
#   https://www.gosuslugi.ru/crt
#   or Sber docs / russiantrustedca.pem
GIGACHAT__HTTP__VERIFY=certs/russiantrustedca.pem
# GIGACHAT__HTTP__VERIFY=True
# GIGACHAT__HTTP__VERIFY=False

# Optional pool / timeout overrides (seconds); keys: base, image, prompt, models
# GIGACHAT__HTTP__MAX_CONNECTIONS=10
# GIGACHAT__HTTP__MAX_KEEPALIVE_CONNECTIONS=10
# GIGACHAT__HTTP__KEEPALIVE_EXPIRY=10
# GIGACHAT__HTTP__TIMEOUTS__IMAGE__TIMEOUT=120
# GIGACHAT__HTTP__TIMEOUTS__IMAGE__READ=120

# Resilience (defaults: redis storage — required in PROD)
# GIGACHAT__RETRIER__ATTEMPTS=3
# GIGACHAT__LIMITER__STORAGE=redis
# GIGACHAT__LIMITER__LIMITS__BASE=1/second
# GIGACHAT__BREAKER__STORAGE=redis
# GIGACHAT__BREAKER__THRESHOLD=6

# ===== SENTRY =====

# DSN для интеграции с Sentry (Data Source Name)
# Получите на https://sentry.io/ после создания проекта
# SENTRY_DSN=https://ea4f105e9360e0b3acd54ce9dd4412e8@o4510471955939328.ingest.de.sentry.io/4510471960395856

# Название окружения для Sentry (опционально)
# SENTRY_ENVIRONMENT=DEV

# Версия релиза для Sentry (опционально)
# RELEASE=

# ==========================================
# ПРИМЕЧАНИЯ
# ==========================================
# - Никогда не коммитьте файл .env в Git
# - Проверьте права доступа к файлу .env (chmod 600 .env)
# - После изменения .env перезапустите бота
# - Используйте кавычки если в значениях есть пробелы
# ==========================================
